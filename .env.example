# God 配置文件模板：复制为 .env 并填入你的 Key（只需任意一家）

# ── 方式一：阿里百炼 DashScope（推荐，免费申领 https://bailian.console.aliyun.com）──
DASHSCOPE_API_KEY=sk-你的key

# ── 方式二：中转站 / 任意 OpenAI 兼容接口 ──
# RELAY_API_KEY=sk-你的key
# RELAY_BASE_URL=https://你的中转站/v1

# ── 方式三：智谱 bigmodel ──
# ZHIPU_API_KEY=你的key

# 默认后端与模型（留空=自动选择已配置的后端及其默认模型）
# VENDOR=qwen
# MODEL=
